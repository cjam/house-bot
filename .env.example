# Telegram bot token from @BotFather
TELEGRAM_TOKEN=

# Comma-separated list of Telegram chat IDs allowed to talk to the bot
ALLOWED_CHAT_IDS=

# MCP servers as a single JSON object: { "<name>": <McpServerConfig>, ... }.
# Add as many servers as you like — no code or per-server env vars needed.
# Must be a single line. http and sse transports are supported; put the full
# Authorization header (including the token) directly in the JSON.
# Example (Mealie over HTTP; add more keys for Homebox, etc.):
MCP_SERVERS={"mealie":{"type":"http","url":"http://mealie.local:9000/api/mcp","headers":{"Authorization":"Bearer YOUR_MEALIE_TOKEN"}}}

# --- Provider ---
# Which provider to route through: openrouter (default), anthropic, openai, google.
# Only openrouter is wired today; the others are a seam in src/provider.ts. Each
# provider reads its own <PROVIDER>_API_KEY and <PROVIDER>_MODEL below; only the
# active provider's block is used, so unrelated keys can stay blank.
PROVIDER=openrouter

# OpenRouter (default): one key reaching every model family. MODEL is a slug —
# swap freely. Claude Sonnet is the recommended pick: multi-step meal planning
# over a long back-and-forth (proposing a week, applying swaps, writing it to
# Mealie) needs a capable model — a smaller one tends to lose the thread and
# re-ask. Swap to a cheaper slug (e.g. google/gemini-2.5-flash) for lighter use.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Direct providers (only read when PROVIDER selects them). Models here use the
# provider's native id, not an OpenRouter slug.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# GOOGLE_GENERATIVE_AI_API_KEY=
# GOOGLE_MODEL=gemini-2.5-flash

# --- Optional overrides ---
# Base persona/instructions for the agent. Tailor it to this instance's MCP
# servers. Always-on context (today's date, etc.) is layered on automatically,
# so you don't need to include it here. Falls back to a sensible default if unset.
# SYSTEM_PROMPT=You are a concise household assistant for the Smith family. You have Mealie (recipes/meal plans) and Homebox (inventory) tools.
# Timezone used for the "today's date" the bot tells the model (so "this week"
# and meal-plan dates line up with your local days). Defaults to UTC if unset.
TZ=America/Vancouver
# Max steps in the agentic tool loop before a turn stops.
MAX_STEPS=12
# Enable the provider's web-search tool (OpenRouter only for now).
WEB_SEARCH=false
# Home coordinates for the built-in get_weather tool (used to steer meal
# planning by the forecast). Defaults to Victoria, B.C.; the tool also accepts
# per-call lat/long for a temporary location.
# HOME_LAT=48.496
# HOME_LONG=-123.393
SESSION_FILE=./data/sessions.json
# Minutes of chat inactivity before the next message starts a fresh session
# instead of resuming the old one. Raise it (e.g. 720 = 12h) if the bot forgets
# mid-task in a household group that chats intermittently.
SESSION_IDLE_MINUTES=15
# Optional append-only transcript log for analysis: one JSONL file per chat at
# <dir>/<chatId>.jsonl, one turn per line (prompt, reply, tool calls, token
# usage, latency, fresh-vs-resumed). Unset (default) disables it. Point it under
# ./data so it persists in the Docker volume.
# TRANSCRIPT_DIR=./data/logs
# Where scheduled prompts are persisted. Manage them from Telegram with
# /schedules, or just ask the bot in plain language — recurring ("every Sunday
# at 5pm, start planning next week's meals") or one-off ("remind me tomorrow at
# 4pm"). Times use the TZ set above.
SCHEDULE_FILE=./data/schedules.json
# Where per-chat settings overrides are persisted. Each chat can override the
# system prompt, location, timezone, model, and max steps — via /settings,
# /setlocation, /setprompt (or just asking). The values above are the defaults.
SETTINGS_FILE=./data/settings.json
